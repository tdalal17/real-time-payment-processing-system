		{
			"name": "1. Payment Processing",
			"item": [
				{
					"name": "Create Payment (Success)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has transaction_id\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('transaction_id');",
									"    pm.environment.set('transaction_id', jsonData.transaction_id);",
									"});",
									"",
									"pm.test(\"Payment status is completed\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('completed');",
									"});",
									"",
									"pm.test(\"Response includes fraud check\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('fraud_check');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-Key",
								"value": "pk_demo_4dMUudRZuMNQYNMJlJ5fPvoGGq-CcUbZq7_OI5kS7eQ",
								"description": "Admin API Key (Full Access)"
							},
